# Copy this file to .env. Never commit the resulting .env file.

# Application
APP_NAME=Tripana
APP_ENV=development
APP_DEBUG=false
APP_PORT=8000
SECRET_KEY=replace-with-a-long-random-value

# URLs exposed on the host machine
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# PostgreSQL
POSTGRES_DB=tripana
POSTGRES_USER=tripana
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgresql+asyncpg://tripana:replace-with-a-database-password@localhost:5432/tripana

# Authentication cookies and JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Email (optional; required for OTP email delivery)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_PATH=/auth/callback

# Places providers (optional; required for live place search)
MAPBOX_TOKEN=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MONTHLY_QUOTA=10000

# Runtime files
RSA_PRIVATE_KEY_PATH=backend/keys/private_key.pem
RSA_PUBLIC_KEY_PATH=backend/keys/public_key.pem
USAGE_DATA_DIR=backend/runtime
OTP_CLEANUP_INTERVAL_SECONDS=60
